{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@0.7.4",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/:path*",    "destination": "/index.html" }
  ],
  "env": {
    "WEBSEEKER_DATA": "/tmp/data"
  }
}
